HF_ENDPOINT=https://hf-mirror.com

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=gmall

NEO4J_URI=neo4j://localhost
NEO4J_USER=neo4j
NEO4J_PASSWORD=graph_rag_demo

MODEL_NAME=google-bert/bert-base-chinese

# RAG 模型
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5
LLM_MODEL_NAME=deepseek-chat

# CDC / Debezium / Kafka
CDC_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CDC_KAFKA_GROUP_ID=graph-rag-cdc
CDC_TOPIC_PREFIX=gmall
DEBEZIUM_CONNECT_URL=http://localhost:8083
DEBEZIUM_CONNECTOR_NAME=gmall-mysql-connector
DEBEZIUM_DATABASE_HOST=mysql
DEBEZIUM_DATABASE_PORT=3306
DEBEZIUM_DATABASE_SERVER_ID=184054

# Milvus entity retrieval
ENTITY_RETRIEVAL_BACKEND=neo4j
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=commerce_entities
MILVUS_EMBEDDING_DIM=1024
MILVUS_METRIC_TYPE=COSINE

# UIE model from ModelScope
UIE_MODEL_ID=iic/nlp_structbert_siamese-uie_chinese-base
UIE_MODEL_DIR=models/uie
UIE_MAX_LENGTH=256
UIE_BATCH_SIZE=16
UIE_EPOCHS=5
UIE_LEARNING_RATE=2e-5
UIE_DEVICE=cuda
